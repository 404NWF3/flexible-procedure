{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contribution loop candidate submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "contract_id",
    "parent_ids",
    "hypothesis",
    "mechanism",
    "interfaces",
    "parameters",
    "bundle_sha256",
    "interface_version",
    "training_provenance",
    "randomization_rule",
    "expected_tradeoffs"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "contract_id": {
      "const": "soft-procedure-contribution-loop-v1"
    },
    "parent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dispatch",
          "release",
          "admission",
          "defer"
        ]
      }
    },
    "parameters": {
      "type": "object"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "interface_version": {
      "type": "string",
      "minLength": 1
    },
    "training_provenance": {
      "type": "string",
      "minLength": 1
    },
    "randomization_rule": {
      "type": "string",
      "minLength": 1
    },
    "expected_tradeoffs": {
      "type": "string",
      "minLength": 1
    }
  },
  "$comment": "This validates submission metadata only. It does not enforce isolation, candidate semantics, hashes, or metrics. Those belong to the trusted evaluator."
}
