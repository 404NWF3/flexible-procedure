      "id": "schema",
      "area": "观测与执行接口",
      "authority": "可信维护层审查后升级",
      "allowed": "提出新传感字段、动作原语或必要依赖的变更请求",
      "boundary": "搜索 Agent 不改接口、合法性检查和隔离；新版本重做基准验证"
    },
    {
      "id": "scenario",
      "area": "物理与业务情景",
      "authority": "负责人另建题目版本",
      "allowed": "提出扩容、改善换模/可靠性、调整需求、增加真实保供约束的情景",
      "boundary": "不进入当前榜单，不与现有资源下的调度收益混算"
    },
    {
      "id": "judge",
      "area": "目标与评分",
      "authority": "搜索 Agent 不可修改",
      "allowed": "读取公式、检查结果、提出疑似缺陷",
      "boundary": "不改 G、价格/费率、终止口径、初始状态、样本筛选、置信规则或原始账本"
    },
    {
      "id": "inputs",
      "area": "题目与随机环境",
      "authority": "搜索 Agent 不可修改",
      "allowed": "读取公开分布和既定参数",
      "boundary": "不改路线、设备、缓冲、来料、产品比例、故障模型；不选终测种子或重置环境"
    }
  ],
  "proposed_runtime_interface": {
    "status": "requires_trusted_implementation",
    "transport": "serialized observations and validated actions across an OS permission boundary",
    "observations": [
      "current_simulation_time",
      "remaining_time_to_declared_horizon",
      "arrived_job_opaque_handles",
      "products_and_remaining_routes",
      "nominal_processing_distributions",
      "public_prices_and_rate",
      "current_queues_and_pending_requests",
      "machine_states_and_last_family",
      "elapsed_work_wait_repair_and_observed_histories",
      "current_wip_tokens_and_backlog"
    ],
    "excluded": [
      "environment_seed",
      "replication_id",
      "evaluation_stage",
      "source_schedule",
      "SimPy_event_queue",
      "RNG_state",
      "machine_life_left",
      "unfinished_operation_true_required_processing",
      "future_failure_or_repair_duration",
      "mutable_simulation_objects",
      "hidden_evaluation_files"
    ],
    "actions": [
      "dispatch_matching_at_station",
      "release_order_and_dynamic_token_limit",
      "rank_eligible_admission_requests",
      "defer_decision_with_trusted_positive_timer"
    ],
    "defer_max_minutes": 15,
    "negative_or_zero_time_defer": false,
    "job_preemption": false,
    "action_commit": "trusted_atomic_validator",
    "reset_policy_state_each_replication": true,
    "cross_replication_learning": false,
    "policy_randomness": "separate private policy stream; never derived by the candidate from environment seed",
    "online_planning": "allowed with public distributions and independent private planning randomness; no true future access"
  },
