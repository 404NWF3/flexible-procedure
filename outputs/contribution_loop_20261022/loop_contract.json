{
  "schema_version": "1.0",
  "contract_id": "soft-procedure-contribution-loop-v1",
  "authored_date": "2026-10-22",
  "status": "design_only_not_executed",
  "enforcement_implemented": false,
  "objective": {
    "metric": "operating_contribution",
    "direction": "maximize",
    "aggregation": "mean_across_all_prespecified_replications_only_if_entire_candidate_stage_valid",
    "unit": "CNY per 2400 working minutes",
    "formula": "sum_p(price[p] * completed_before_H[p]) - (100/60) * sum_m(processing_minutes_in_window[m] + setup_minutes_in_window[m])",
    "horizon": 2400,
    "window": "[0,H)",
    "initial_state": "empty",
    "warmup": 0,
    "repair_blocked_idle_charged": false,
    "include_unfinished_processing_and_setup_cost": true,
    "wip_revenue": 0,
    "co_objectives": [],
    "diagnostics": [
      "total_completed",
      "completed_by_product",
      "unreleased_by_product",
      "unfinished_by_product",
      "waiting_and_age",
      "processing_cost",
      "setup_cost",
      "revenue",
      "machine_states"
    ],
    "contractual_delivery_constraints": []
  },
