  "fixed_semantics": [
    "first arrival waits for first exponential interval",
    "positive normal processing samples; reject nonpositive draws",
    "first setup free per machine; family state persists",
    "failure clock advances only during processing and setup",
    "exponential repair; resume remaining work",
    "buffer limit applies to waiting jobs, not machine-occupied jobs",
    "blocking after service; upstream held until downstream accepts",
    "zero transport time; no extra resource or transit storage",
    "all arrivals remain accounted for; no cancellation",
    "no end-of-horizon flushing or salvage credit"
  ],
  "reference_policies": [
    "fifo",
    "same_family"
  ],
  "permissions": [
    {
      "id": "dispatch",
      "area": "派工与批量",
      "authority": "Agent 可自行尝试",
      "allowed": "经济排序、同类合批、老化、工位差异规则、多机与工件联合匹配、受控等待",
      "boundary": "只能选已准入且工序合法的工件；不抢占、不跳工序、不改工时"
    },
    {
      "id": "release",
      "area": "放行与准入",
      "authority": "Agent 可自行尝试",
      "allowed": "动态 CONWIP、分产品/工位限额、放行顺序、内外部请求优先级、全线联动",
      "boundary": "所有来料照常到达并入账；不删单；下游接收前仍占用上游机床"
    },
    {
      "id": "algorithm",
      "area": "算法与内部表示",
      "authority": "Agent 可自行尝试",
      "allowed": "规则组合、分段函数、搜索、离线学习、强化学习、滚动规划、运行内状态估计",
      "boundary": "只用允许观测与独立规划随机流；不读真实未来；遵守算力预算"
